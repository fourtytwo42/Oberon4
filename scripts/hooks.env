# Hooks configuration (portable defaults)

# Policy mode:
# - strict: full metadata and evidence contract (default)
# - minimal: reduced metadata burden for smaller-model workflows while preserving core safety gates
HOOKS_POLICY_MODE=strict

# Optional automatic sync from BOS -> standalone bos-policy-kit on pre-push.
# 1 = if policy stack files changed, run scripts/sync-policy-kit.sh before BOS push completes
HOOKS_AUTO_SYNC_POLICY_KIT_ON_PUSH=0
POLICY_KIT_REPO_DIR="$HOME/bos-policy-kit"
POLICY_KIT_TARGET_BRANCH=main

# Stack map controls: prevent cross-stack policy bleed.
HOOKS_ENFORCE_STACK_MAP=1
STACK_MAP_FILE="docs/policy/stack-map.env"

# Optional explicit repo slug (owner/repo). If empty, derived from git remote origin.
HOOKS_REPO_SLUG=fourtytwo42/Oberon

# Require issue-state validation via GitHub API during pre-push.
# 1 = fail when issue state cannot be verified
# 0 = warn and continue when gh/repo unavailable
HOOKS_REQUIRE_GH_ISSUE_VALIDATION=0

# Enforce that issue URLs in commit messages match this repo when slug is known.
# 1 = strict same-repo URLs, 0 = allow any GitHub issue URL
HOOKS_REQUIRE_SAME_REPO_URL=1

# Churn escalation thresholds
CHURN_ESCALATION_FILES=12
CHURN_ESCALATION_LINES=300

# Context pack budget defaults
CONTEXT_TOKEN_BUDGET=8000
CONTEXT_TOKEN_WARN_PCT=70
CONTEXT_BUDGET_STRICT=0

# Path regex for gates
ADR_REQUIRED_PATH_REGEX='^apps/|^packages/|^src/|^infrastructure/|^api/|^docs/architecture/'
CHANGE_REQUEST_REQUIRED_PATH_REGEX='^apps/|^packages/|^src/|^api/|^infrastructure/migrations/|openapi|schema'
# Path regex to identify contract/interface-impact files that require compatibility metadata
CONTRACT_COMPAT_REQUIRED_PATH_REGEX='openapi|schema|contract|interface|api/'

# Test contract enforcement in commit messages
# 1 = require Stack/TestScope fields for code-impacting commits
HOOKS_ENFORCE_TEST_CONTRACT=1
# 1 = require verification commands that match declared Stack
HOOKS_ENFORCE_STACK_COMMAND_HINTS=1

# 1 = require high-risk commits to include threat model declaration
HOOKS_REQUIRE_HIGH_RISK_THREAT_MODEL=1
# 1 = require high-risk commits to include rollback rehearsal evidence
HOOKS_REQUIRE_HIGH_RISK_ROLLBACK_REHEARSAL=1
# 1 = require medium/high risk commits to include quality signals beyond pass/fail tests
HOOKS_REQUIRE_MEDIUM_HIGH_QUALITY_SIGNALS=1
# 1 = require untrusted input boundary declaration for security changes
HOOKS_REQUIRE_SECURITY_TRUST_BOUNDARY=1
# 1 = validate policy exception metadata when PolicyException: yes is present
HOOKS_ENFORCE_POLICY_EXCEPTION_FIELDS=1
# 1 = require medium/high risk commits to declare layered review passes
HOOKS_REQUIRE_REVIEW_PASSES=1
# 1 = require high-risk commits to declare review packet completeness
HOOKS_REQUIRE_HIGH_RISK_REVIEW_PACKET=1
# 1 = require dependency verification metadata when manifest files are staged
HOOKS_REQUIRE_DEPENDENCY_CHECK=1
# bugfix commit high-context threshold (staged file count)
BUGFIX_HIGH_CONTEXT_FILE_THRESHOLD=10
# 1 = require high-risk commits to include explicit second review metadata
HOOKS_REQUIRE_HIGH_RISK_SECOND_REVIEW=1
# 1 = require security/high-risk commits to include human+tooling security signoff metadata
HOOKS_REQUIRE_SECURITY_SIGNOFF=1
# 1 = reject expired exception/flaky dates in commit metadata
HOOKS_REJECT_EXPIRED_POLICY_DATES=1
# 1 = require medium/high risk commits to declare one primary review focus
HOOKS_REQUIRE_REVIEW_FOCUS=1
# 1 = require security commits to reference a security checklist artifact
HOOKS_REQUIRE_SECURITY_CHECKLIST=1
# 1 = require explicit security scan declaration for security/high-risk commits
HOOKS_REQUIRE_SECURITY_SCANS_DECLARATION=1
# 1 = require performance evidence metadata when ReviewFocus is performance
HOOKS_REQUIRE_PERFORMANCE_EVIDENCE=1
# 1 = also require performance evidence metadata for high-risk commits
HOOKS_REQUIRE_HIGH_RISK_PERFORMANCE_EVIDENCE=1
# 1 = require maintainability evidence metadata when ReviewFocus is maintainability
HOOKS_REQUIRE_MAINTAINABILITY_EVIDENCE=1
# 1 = require observability metadata for medium/high risk commits
HOOKS_REQUIRE_OBSERVABILITY_EVIDENCE=1
# 1 = require explicit agent role metadata for medium/high risk commits
HOOKS_REQUIRE_AGENT_ROLE=1
# 1 = require explicit stack profile metadata for medium/high risk commits
HOOKS_REQUIRE_STACK_PROFILE=1
# 1 = require medium/high risk self-evaluation and policy delta metadata
HOOKS_REQUIRE_SELF_EVAL=1
# 1 = require privacy/data-handling metadata for security/high-risk commits
HOOKS_REQUIRE_DATA_HANDLING_DECLARATION=1
# 1 = require release strategy + runbook metadata for high-risk commits
HOOKS_REQUIRE_RELEASE_SAFETY_FIELDS=1
# 1 = require compatibility/deprecation metadata when contract/interface files are staged
HOOKS_REQUIRE_COMPATIBILITY_FIELDS=1
# 1 = require dependency license/compliance metadata when dependency manifests are staged
HOOKS_REQUIRE_DEPENDENCY_LICENSE_CHECK=1
# 1 = run policy drift audit on pre-push
HOOKS_RUN_POLICY_DRIFT_AUDIT=1
# 1 = run exception debt report on pre-push
HOOKS_RUN_EXCEPTION_DEBT_REPORT=1
# if 1, exception debt report fails on nearing/expired records; if 0, warning-only
HOOKS_EXCEPTION_DEBT_STRICT=0
# days horizon for "expiring soon" in exception debt report
HOOKS_EXCEPTION_DEBT_HORIZON_DAYS=14

# Local CI gate on pre-push (smoke -> tests -> build)
HOOKS_RUN_LOCAL_CI_ON_PUSH=1
# Stack-agnostic defaults:
# - set commands for your repo/toolchain
# - then enable strict + required flags
HOOKS_LOCAL_CI_STRICT=0
HOOKS_LOCAL_CI_REQUIRE_SMOKE=0
HOOKS_LOCAL_CI_REQUIRE_TEST=0
HOOKS_LOCAL_CI_REQUIRE_BUILD=0
HOOKS_LOCAL_SMOKE_CMD=""
HOOKS_LOCAL_TEST_CMD=""
HOOKS_LOCAL_BUILD_CMD=""
