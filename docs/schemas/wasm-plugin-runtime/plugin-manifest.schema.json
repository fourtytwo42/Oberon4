{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oberon4.local/schemas/wasm-plugin-runtime/plugin-manifest.schema.json",
  "title": "PluginManifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "version",
    "displayName",
    "description",
    "runtimeApiVersion",
    "commands",
    "capabilities",
    "prompting",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "runtimeApiVersion": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/commandManifest" }
    },
    "capabilities": { "$ref": "#/$defs/capabilityManifest" },
    "prompting": { "$ref": "#/$defs/promptingManifest" },
    "provenance": { "$ref": "#/$defs/provenanceManifest" },
    "lifecycle": { "$ref": "#/$defs/lifecycleActions" },
    "requestedResources": { "$ref": "#/$defs/resourceBudgetRequest" }
  },
  "$defs": {
    "commandManifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version",
        "description",
        "inputSchema",
        "outputSchema",
        "sideEffects",
        "requiredCapabilities"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sideEffects": {
          "type": "string",
          "enum": [
            "none",
            "ephemeral",
            "plugin-private-write",
            "external-read",
            "external-write",
            "destructive"
          ]
        },
        "requiredCapabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approvalExpectation": {
          "type": "string",
          "enum": ["none", "recommended", "required"]
        },
        "supportsPlanning": { "type": "boolean" },
        "supportsPagination": { "type": "boolean" },
        "supportsArtifacts": { "type": "boolean" },
        "preconditionModel": {
          "type": "string",
          "enum": ["none", "workspace-revision", "file-hash", "patch-context"]
        },
        "requestedResources": { "$ref": "#/$defs/resourceBudgetRequest" }
      }
    },
    "capabilityManifest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "storage": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "private": { "type": "boolean" },
            "session": { "type": "boolean" },
            "cache": { "type": "boolean" }
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "read": { "type": "boolean" },
            "write": { "type": "boolean" }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "read": { "type": "boolean" },
            "create": { "type": "boolean" }
          }
        },
        "services": { "type": "array", "items": { "type": "string" } }
      }
    },
    "promptingManifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "promptVersion",
        "summary",
        "whenToUse",
        "whenNotToUse"
      ],
      "properties": {
        "promptVersion": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "whenToUse": { "type": "string", "minLength": 1 },
        "whenNotToUse": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["intent", "command"],
            "properties": {
              "intent": { "type": "string" },
              "command": { "type": "string" }
            }
          }
        },
        "failureRecovery": {
          "type": "array",
          "items": { "type": "string" }
        },
        "safetyNotes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "provenanceManifest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["publisher", "source", "checksum"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "minLength": 1 },
        "signature": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "format": { "type": "string" },
            "value": { "type": "string" },
            "key_id": { "type": "string" }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "target": { "type": "string" },
            "createdAt": { "type": "string" }
          }
        }
      }
    },
    "lifecycleActions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "install": { "type": "boolean" },
        "validate": { "type": "boolean" },
        "activate": { "type": "boolean" },
        "deactivate": { "type": "boolean" },
        "upgrade": { "type": "boolean" },
        "uninstall": { "type": "boolean" },
        "hooks": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "onInstall": { "type": "boolean" },
            "onUpgrade": { "type": "boolean" },
            "healthCheck": { "type": "boolean" }
          }
        }
      }
    },
    "resourceBudgetRequest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "memoryBytes": { "type": "integer", "minimum": 0 },
        "timeMs": { "type": "integer", "minimum": 0 },
        "storageBytes": { "type": "integer", "minimum": 0 },
        "outputBytes": { "type": "integer", "minimum": 0 },
        "artifactBytes": { "type": "integer", "minimum": 0 },
        "networkPolicy": {
          "type": "string",
          "enum": ["denied", "brokered-only", "allowlisted"]
        }
      }
    }
  }
}
