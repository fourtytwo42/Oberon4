{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oberon4.local/schemas/wasm-plugin-runtime/approval-request.schema.json",
  "title": "ApprovalRequestPayload",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "approvalId",
    "tool",
    "command",
    "summary",
    "sideEffects",
    "resourceLimits"
  ],
  "properties": {
    "approvalId": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "sideEffects": {
      "type": "string",
      "enum": [
        "none",
        "ephemeral",
        "plugin-private-write",
        "external-read",
        "external-write",
        "destructive"
      ]
    },
    "workspaceImpact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["workspaceHandle", "workspaceRevision", "touchedPaths"],
      "properties": {
        "workspaceHandle": { "type": "string" },
        "workspaceRevision": { "type": "string" },
        "touchedPaths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "remoteImpact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "remote", "branch"],
      "properties": {
        "provider": { "type": "string" },
        "remote": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "serviceHandlesUsed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "secretClassesInvolved": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "api_credential",
          "oauth_credential",
          "ssh_key",
          "wallet_key"
        ]
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "timeMs": { "type": "integer", "minimum": 0 },
        "memoryBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "diffSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["filesChanged", "insertions", "deletions"],
      "properties": {
        "filesChanged": { "type": "integer", "minimum": 0 },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
