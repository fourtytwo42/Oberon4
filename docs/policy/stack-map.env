# Stack map for policy enforcement.
# Configure only stacks used by this repository to prevent cross-stack rule bleed.
#
# Example:
# STACK_ACTIVE_PROFILES="node"
# STACK_NODE_PATH_REGEX='(^|/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock)|\.(ts|tsx|js|jsx)$'

# Comma-separated active stack profiles for this repo.
STACK_ACTIVE_PROFILES="rust"

# Optional per-stack path detection regex overrides.
# Leave commented unless you need repo-specific tuning.
# STACK_NODE_PATH_REGEX='...'
# STACK_PYTHON_PATH_REGEX='...'
# STACK_GO_PATH_REGEX='...'
# STACK_JAVA_PATH_REGEX='...'
# STACK_DOTNET_PATH_REGEX='...'
# STACK_RUST_PATH_REGEX='...'
# STACK_PHP_PATH_REGEX='...'
# STACK_RUBY_PATH_REGEX='...'
