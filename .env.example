# PM2/runtime defaults for llmhotspot-v2
APP_NAME=llmhotspot-v2-api
BINARY_PATH=/home/hendo420/llmhotspot-v2/target/debug/llmhotspot
DB_PATH=/tmp/llmhotspot-live.db
LISTEN_ADDR=0.0.0.0:11434

# Optional: when binding to `0.0.0.0` / `[::]`, this controls what hostname/IP the UI displays
# for the "Local" endpoint.
# LLMHOTSPOT_LOCAL_ADVERTISE_HOST=192.168.50.10

# Tunnel broker base URL (per-device tunnel token + subdomain assignment).
# Point this at your broker service (llmhotspot with LLMHOTSPOT_TUNNEL_BROKER=1).
LLMHOTSPOT_TUNNEL_BROKER_URL=https://keys.llmhotspot.com
# Back-compat alias (older builds):
# LLMHOTSPOT_WEBSITE_BASE_URL=https://keys.llmhotspot.com
LLMHOTSPOT_LICENSE_KEY=replace-with-your-license-key
LLMHOTSPOT_DEVICE_ID=replace-with-your-device-id
LLMHOTSPOT_ENDPOINT_SLUG=young-kernel-beacon

# Cloudflare automation (tunnels + DNS)
# CF_API_TOKEN=replace-with-your-cloudflare-api-token
# CF_ACCOUNT_ID=replace-with-your-cloudflare-account-id
# CF_ZONE_ID=replace-with-your-cloudflare-zone-id
# CF_BASE_DOMAIN=llmhotspot.com

# Optional direct fallback assignment (if website/control-plane assignment is unavailable)
# LLMHOTSPOT_REMOTE_BASE_URL=https://your-endpoint.llmhotspot.com/v1
# LLMHOTSPOT_REMOTE_CONSOLE_URL=https://your-endpoint.llmhotspot.com/console?admin_key=rcs_xxx

# Billing reminder dispatch (broker -> website internal email relay)
# LLMHOTSPOT_REMINDER_WEBHOOK_URL=https://llmhotspot.com
# LLMHOTSPOT_REMINDER_INTERNAL_SECRET=replace-me
